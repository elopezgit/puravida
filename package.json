{
  "name": "hongos-pura-vida",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Landing de marca y catálogo — Hongos Pura Vida",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "check": "node scripts/check-dev.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:legibility": "node scripts/check-legibility.mjs",
    "check:text-size": "node scripts/check-text-size.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:all": "tsc -b && node scripts/check-copy.mjs && node scripts/check-tokens.mjs && node scripts/check-contrast.mjs && node scripts/check-legibility.mjs && node scripts/check-text-size.mjs && node scripts/check-assets.mjs",
    "optimize": "node scripts/optimize-media.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lenis": "^1.3.11",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
